# Copy to .env and fill in. Never commit .env.

# Dashboard logins are per person: add them with  python manage_users.py add <username> <device_id>

# Keeps people logged in across restarts. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# One entry per bin, comma separated:
#   <device_id>=hmac:<shared secret>             (same secret as DEVICE_HMAC_KEY in include/secrets.h)
#   <device_id>=ecdsa:<ATECC608A public key hex> (128 hex characters)
# Generate an HMAC secret with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DEVICE_KEYS=bin-1=hmac:replace-with-a-long-random-secret

# 5000 is taken by AirPlay Receiver on macOS.
PORT=5001
# Set to true when the dashboard is served over HTTPS (for example behind Caddy in the cloud).
SESSION_COOKIE_SECURE=false
# DATABASE_URL=sqlite:////absolute/path/to/trash_can.db
